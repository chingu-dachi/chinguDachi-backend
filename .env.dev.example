# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_PASSWORD=your-secure-password-here

# JWT
JWT_SECRET=your-jwt-secret-base64-encoded-min-256-bits

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://dev.chingu-dachi.com/auth/callback

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# CORS
CORS_ALLOWED_ORIGINS=https://dev.chingu-dachi.com

# Domain (for upload URLs)
DOMAIN=api-dev.chingu-dachi.com
